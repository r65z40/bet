# --- La Salle RN6 : configuration Apache ---
Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8
AddType application/manifest+json .webmanifest
AddType text/javascript .js

# Anciennes adresses .html -> nouvelles pages PHP (conserve le référencement)
RedirectMatch 301 ^(.*/)?index\.html$ $1
RedirectMatch 301 ^(.*/)?plan\.html$ $1plan
RedirectMatch 301 ^(.*/)?reservation\.html$ $1reservation

# Forcer le HTTPS (décommenter une fois le certificat SSL actif ;
# ne pas activer si le site est derrière un CDN qui gère lui-même le HTTPS)
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} off
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

# Adresses sans « .php » : /plan, /reservation, /conditions…
# Les anciennes adresses en .php sont redirigées définitivement (301 : Google transfère le référencement).
# Seules les pages vues par les visiteurs sont concernées : api.php, paiement, webhook Stripe, cron… gardent leur adresse.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Signale au site que les adresses propres fonctionnent (liens générés sans .php)
  RewriteRule ^ - [E=RN6_CLEAN_URLS:1]
  # /page.php → /page (visites directes uniquement, jamais les envois de formulaires)
  RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteRule ^(plan|reservation|conditions|mentions-legales|confidentialite|ma-reservation|facture|desinscription)\.php$ $1 [R=301,L]
  RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteRule ^index\.php$ ./ [R=301,L]
  # /page → page.php (en interne, invisible pour le visiteur)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^([a-z0-9-]+)$ $1.php [L]
</IfModule>

# Dossiers et fichiers internes jamais accessibles depuis le web
RedirectMatch 404 ^(.*/)?(data|includes|\.git)(/.*)?$
<FilesMatch "(\.(sqlite|sqlite-wal|sqlite-shm|md|ini|log|lock)$|^\.)">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Compression des pages, styles et scripts (pages ~4 fois plus légères à télécharger)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/manifest+json text/calendar image/svg+xml image/x-icon
</IfModule>

# Cache navigateur : les fichiers sont appelés avec ?v=date, une modification est donc vue tout de suite
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 month"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>
# Le service worker de l'admin doit toujours être relu (mises à jour de l'appli iPhone)
<FilesMatch "^(sw\.js|manifest\.webmanifest)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache"
  </IfModule>
  <IfModule mod_expires.c>
    ExpiresActive Off
  </IfModule>
</FilesMatch>

# Taille des envois de photos (si l'hébergeur l'autorise ; sinon voir .user.ini)
<IfModule mod_php.c>
  php_value upload_max_filesize 10M
  php_value post_max_size 80M
</IfModule>
